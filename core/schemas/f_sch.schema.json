{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "noteCode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "content": {
      "type": "object",
      "properties": {
        "experiment": {
          "type": "object",
          "properties": {
            "project": {
              "type": "string"
            },
            "reactionType": {
              "type": "string"
            },
            "experimentDate": {
              "type": "string"
            },
            "references": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "schemes": {
          "type": "object",
          "properties": {
            "batch": {
              "type": "string"
            },
            "flow": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "hardware": {
          "type": "object",
          "properties": {
            "tubeInnerDiameterMM": {
              "type": "number"
            },
            "tubeLengthM": {
              "type": "number"
            },
            "tubeVolumeML": {
              "type": "number"
            },
            "residenceTimeM": {
              "type": "number"
            },
            "totalFlowRateMLPerMin": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "setup": {
          "type": "object",
          "properties": {
            "reactionTemperatureC": {
              "type": "number"
            },
            "backPressureBarPSI": {
              "type": "number"
            },
            "mixerTypes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "stockParameters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pumpName": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "flowRateMLPerMin": {
                "type": "number"
              },
              "volumeML": {
                "type": "number"
              },
              "concM": {
                "type": "number"
              },
              "solvents": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "ratio": {
                      "type": "number"
                    },
                    "volumeML": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "components": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "limiting": {
                      "type": "boolean"
                    },
                    "pumpLimiting": {
                      "type": "boolean"
                    },
                    "reagent": {
                      "type": "string"
                    },
                    "molecularWeightGPerMol": {
                      "type": "number"
                    },
                    "massG": {
                      "type": "number"
                    },
                    "mmol": {
                      "type": "number"
                    },
                    "eq": {
                      "type": "number"
                    },
                    "densityGPerML": {
                      "type": "number"
                    },
                    "weightPercent": {
                      "type": "number"
                    },
                    "volumeML": {
                      "type": "number"
                    },
                    "molarityM": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "product": {
          "type": "object",
          "properties": {
            "reaction": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "enum": [
                "solution",
                "powder"
              ]
            },
            "name": {
              "type": "string"
            },
            "purityPercent": {
              "type": "number"
            },
            "molecularWeightGPerMol": {
              "type": "number"
            },
            "theoreticalYieldG": {
              "type": "number"
            },
            "actualYieldG": {
              "type": "number"
            },
            "yieldPercent": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "procedure": {
          "type": "object",
          "properties": {
            "preparation": {
              "type": "string"
            },
            "workupAndPurification": {
              "type": "string"
            },
            "noReactionReason": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "lcms": {
          "type": "object",
          "properties": {
            "retentionTimeMin": {
              "type": "number"
            },
            "description": {
              "type": "string"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
                  },
                  "noteId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
                  },
                  "name": {
                    "type": "string"
                  },
                  "mimeType": {
                    "type": "string"
                  },
                  "sizeBytes": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "createdAt": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "noteId",
                  "name",
                  "mimeType",
                  "sizeBytes",
                  "sha256",
                  "createdAt"
                ],
                "additionalProperties": false
              }
            },
            "ms": {
              "type": "object",
              "properties": {
                "mPerZ": {
                  "type": "number"
                },
                "adduct": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "files"
          ],
          "additionalProperties": false
        },
        "nmrSpectra": {
          "type": "object",
          "properties": {
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
                  },
                  "noteId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
                  },
                  "name": {
                    "type": "string"
                  },
                  "mimeType": {
                    "type": "string"
                  },
                  "sizeBytes": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "createdAt": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "noteId",
                  "name",
                  "mimeType",
                  "sizeBytes",
                  "sha256",
                  "createdAt"
                ],
                "additionalProperties": false
              }
            },
            "description": {
              "type": "string"
            }
          },
          "required": [
            "files"
          ],
          "additionalProperties": false
        },
        "tlc": {
          "type": "object",
          "properties": {
            "solvent": {
              "type": "string"
            },
            "retardationFactor": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "content"
  ],
  "additionalProperties": false
}